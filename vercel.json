{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "backend/src/infrastructure/static/skill-areas.json",
          "backend/src/presentation/docs/swagger-spec.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(api|api-docs|docs|swagger|swagger\\.json)(/.*)?",
      "dest": "backend/src/index.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/((?!api/|api-docs/|docs/|swagger).+\\.[a-zA-Z0-9]+)$",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
