# =============================================================
# Dev Studio — Backend Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to source control.
# =============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_here

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# --- Database (required) ---
# Standard PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev_studio_db
# Vercel Postgres / Supabase pooled connection (alternative)
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# --- AI (optional — required for AI features) ---
OPENAI_API_KEY=sk-proj-...

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- CORS (optional) ---
# Override the frontend URL allowed by CORS (defaults to https://ms-dev-studio.vercel.app)
FRONTEND_URL=http://localhost:5173
# Set to "true" to allow all *.vercel.app preview URLs
ALLOW_VERCEL_PREVIEWS=false

# --- Slack Integration (optional) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
